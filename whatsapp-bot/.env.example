# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne partage jamais ton fichier .env (il contient des clés secrètes).

# Clé API Gemini (Google) — gratuite, créée sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ton numéro WhatsApp personnel (avec indicatif, sans espaces ni "+"),
# où le bot t'enverra un message chaque fois qu'il transmet une conversation
# à un humain. Exemple pour un numéro sénégalais : 221781234567
OWNER_WHATSAPP_NUMBER=

# Numéro WhatsApp Business du bot (celui qui répond aux clients).
# Sert au jumelage par code plutôt que par QR code.
BOT_WHATSAPP_NUMBER=

# Chemin vers le catalogue (par défaut, celui du site juste à côté)
CATALOGUE_CSV_PATH=../catalogue.csv
